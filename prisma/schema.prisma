generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum Priority {
  low
  medium
  high
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  role     Role

  tasks    Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean
  priority  Priority
  userId    Int

  user      User     @relation(fields: [userId], references: [id])
}